---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import { freeResources } from '../../../data/free-resources';
---
<BaseLayout title="Get a free printable" description="Request a free printable from Dr Sarah Cook and The Curious Brain Toolkit." wide>
  <PageIntro
    eyebrow="Free printables"
    title="Get a free printable"
    lead="Choose a resource from Dr Sarah Cook, Clinical Psychologist."
    backHref="/resources/#free-resources"
    backLabel="Back to resources"
  />
  <section class="section">
    <div class="container">
      <form class="contact-channel guide-form" aria-labelledby="guide-form-heading" aria-describedby="guide-preview-note">
        <h2 id="guide-form-heading">Request your PDF</h2>
        <p id="guide-preview-note">This is a preview. Use a sample email address to try the form.</p>
        <fieldset disabled>
          <div>
            <label for="guide-resource">Resource</label>
            <select id="guide-resource">
              <option value="school-morning-guide">“I don’t want to go to school” guide</option>
              {freeResources.map(({ slug, title }) => <option value={slug}>{title}</option>)}
            </select>
          </div>
          <div>
            <label for="guide-name">First name (optional)</label>
            <input id="guide-name" type="text" autocomplete="off" />
          </div>
          <div>
            <label for="guide-email">Email address</label>
            <input id="guide-email" type="email" autocomplete="off" required />
          </div>
          <button class="button button-primary" type="submit">Send me the PDF</button>
        </fieldset>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('.guide-form');
  const fieldset = form?.querySelector('fieldset');
  const resource = form?.querySelector('select');
  if (form && fieldset) {
    const selected = new URLSearchParams(window.location.search).get('resource');
    if (resource && selected && Array.from(resource.options).some((option) => option.value === selected)) {
      resource.value = selected;
    }
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      alert('testing');
    });
    fieldset.disabled = false;
  }
</script>

<style>
  .guide-form { max-width: 540px; }
  fieldset { display: grid; gap: 18px; margin: 0; padding: 0; border: 0; min-width: 0; }
  label { display: block; margin-bottom: 4px; font-weight: 650; }
  input, select { width: 100%; min-height: 44px; padding: 8px 12px; border: 1px solid #9cacb5; border-radius: 7px; font: inherit; color: var(--navy); background: var(--white); }
  button { justify-self: start; cursor: pointer; }
  button:disabled { opacity: .6; cursor: default; }
</style>
