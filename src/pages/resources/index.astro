---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import TopicNav from '../../components/TopicNav.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import Icon from '../../components/Icon.astro';
import { categories, resources } from '../../data/resources';
import { freeResources } from '../../data/free-resources';
const topicNames = ['Thoughts & feelings', 'Worry & anxiety', 'Everyday problem solving'];
---
<BaseLayout title="Psychology-informed resources for children" description="Explore printable toolkits for emotional understanding, worry, anxiety and everyday problem solving." wide>
  <PageIntro eyebrow="The resource collection" title="Find the right place to begin." lead="Practical, printable psychology tools for children aged 8–11 and the adults alongside them.">
    <div class="intro-facts"><span><Icon name="people" /> For home, school and professional settings</span><span><Icon name="document" /> Printable PDFs</span></div>
  </PageIntro>
  <div class="container catalogue">
    <section class="free-printables-callout" aria-labelledby="free-printables-callout-heading">
      <div>
        <h2 id="free-printables-callout-heading">Start with a free printable</h2>
        <p>Choose from Safety Alarm Support Cards and two conversation starters for tricky moments.</p>
      </div>
      <a class="button button-primary" href="#free-resources">See the {freeResources.length} free printables <Icon name="arrow" /></a>
    </section>
    <TopicNav anchors />
    <p class="catalogue-note">Explore the resources here, then visit the individual Etsy listing for purchase details and use permissions.</p>
    {categories.map((category, i) => (
      <section class="catalogue-section" id={category.id} aria-labelledby={`${category.id}-heading`}>
        <div class="catalogue-heading"><div><p class="eyebrow">{`0${i + 1}`} <span aria-hidden="true">/</span> Explore together</p><h2 id={`${category.id}-heading`}>{topicNames[i]}</h2><p>{category.description}</p></div><a class="text-link" href={category.path}>Explore this topic <Icon name="arrow" /></a></div>
        <div class:list={['resource-grid', { 'resource-grid-single': resources.filter((resource) => resource.category === category.id).length === 1 }]}>
          {resources.filter((resource) => resource.category === category.id && !resource.free).map((resource) => <ResourceCard resource={resource} />)}
        </div>
      </section>
    ))}
    <section class="catalogue-section" id="free-resources" aria-labelledby="free-resources-heading">
      <div class="catalogue-heading">
        <div><h2 id="free-resources-heading">Free resources</h2><p>Try a free printable to start a conversation with your child or class.</p></div>
      </div>
      <div class="info-grid">
        {freeResources.map(({ slug, title, description, height }) => (
          <article class="info-card free-resource-card">
            <img src={`/images/free-resources/${slug}.webp`} alt="" width="800" height={height} loading="lazy" />
            <h3>{title}</h3>
            <p>{description}</p>
            <a class="button button-primary" href={`/resources/request/?resource=${slug}`} aria-label={`Request ${title}`}>Get the free PDF</a>
          </article>
        ))}
      </div>
    </section>
    <section class="catalogue-help" aria-labelledby="catalogue-help-heading">
      <div><p class="eyebrow">A few practical details</p><h2 id="catalogue-help-heading">Before you choose</h2><p>Start with what feels relevant to the child, rather than working through everything at once.</p><a class="text-link" href="/our-approach/">Our approach <Icon name="arrow" /></a></div>
      <div class="faq-list">
        <details><summary>How do I purchase a resource?</summary><p>Choose a resource to open its Etsy listing. Check the contents, format and use permissions there before purchasing. Payments and downloads for paid resources are handled by Etsy.</p></details>
        <details><summary>Can I use the resources in a school or team?</summary><p>Ask the seller to confirm the permissions for your setting before buying. <a href="/contact/#school-enquiries">Find out what to include in a school enquiry.</a></p></details>
        <details><summary>Are there free downloads?</summary><p>See the <a href="#free-resources">free resources above</a> for printable PDFs.</p></details>
      </div>
    </section>
  </div>
  <section class="page-cta"><div class="container page-cta-inner"><div><p class="eyebrow">For schools and professionals</p><h2>Choosing resources for your setting?</h2><p>Ask about the resources and the use permissions you need.</p></div><a class="button button-primary" href="/contact/#school-enquiries">School enquiries <Icon name="arrow" /></a></div></section>
</BaseLayout>

<style>
  .free-printables-callout {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 28px;
    margin-bottom: 24px;
    padding: clamp(18px, 3vw, 28px);
    border-left: 4px solid var(--teal);
    border-radius: 9px;
    background: var(--cream);
  }
  .free-printables-callout > div { flex: 1 1 300px; }
  .free-printables-callout h2 { font-size: clamp(1.42rem, 2.7vw, 1.85rem); margin-bottom: 6px; }
  .free-printables-callout p { margin: 0; color: var(--muted); }
  .free-printables-callout .button svg { transform: rotate(90deg); }
  .free-resource-card { display: flex; flex-direction: column; align-items: flex-start; }
  .free-resource-card img { width: 100%; aspect-ratio: 4 / 3; object-fit: contain; margin-bottom: 20px; }
  .free-resource-card .button { margin-top: auto; }
</style>
