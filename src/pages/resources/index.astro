---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import TopicNav from '../../components/TopicNav.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import Icon from '../../components/Icon.astro';
import { categories, resources } from '../../data/resources';
const topicNames = ['Thoughts & feelings', 'Worry & anxiety', 'Everyday problem solving'];
---
<BaseLayout title="Psychology-informed resources for children" description="Explore printable toolkits for emotional understanding, worry, anxiety and everyday problem solving." wide>
  <PageIntro eyebrow="The resource collection" title="Find the right place to begin." lead="Practical, printable psychology tools for children aged 8–11 and the adults alongside them.">
    <div class="intro-facts"><span><Icon name="people" /> For home, school and professional settings</span><span><Icon name="document" /> Printable PDFs</span></div>
  </PageIntro>
  <div class="container catalogue">
    <TopicNav anchors />
    <p class="catalogue-note">Explore the resources here, then visit the individual Etsy listing for purchase details and use permissions.</p>
    {categories.map((category, i) => (
      <section class="catalogue-section" id={category.id} aria-labelledby={`${category.id}-heading`}>
        <div class="catalogue-heading"><div><p class="eyebrow">{`0${i + 1}`} <span aria-hidden="true">/</span> Explore together</p><h2 id={`${category.id}-heading`}>{topicNames[i]}</h2><p>{category.description}</p></div><a class="text-link" href={category.path}>Explore this topic <Icon name="arrow" /></a></div>
        <div class:list={['resource-grid', { 'resource-grid-single': resources.filter((resource) => resource.category === category.id).length === 1 }]}>
          {resources.filter((resource) => resource.category === category.id && !resource.free).map((resource) => <ResourceCard resource={resource} />)}
        </div>
      </section>
    ))}
    <section class="catalogue-help" aria-labelledby="catalogue-help-heading">
      <div><p class="eyebrow">A few practical details</p><h2 id="catalogue-help-heading">Before you choose</h2><p>Start with what feels relevant to the child, rather than working through everything at once.</p><a class="text-link" href="/our-approach/">Our approach <Icon name="arrow" /></a></div>
      <div class="faq-list">
        <details><summary>How do I purchase a resource?</summary><p>Choose a resource to open its Etsy listing. Check the contents, format and use permissions there before purchasing. This website does not handle payments or downloads.</p></details>
        <details><summary>Can I use the resources in a school or team?</summary><p>Ask the seller to confirm the permissions for your setting before buying. <a href="/contact/#school-enquiries">Find out what to include in a school enquiry.</a></p></details>
        <details><summary>Are there free downloads?</summary><p>No free downloads are currently available on this website. <a href="/free-resources/">Read about resource availability.</a></p></details>
      </div>
    </section>
  </div>
  <section class="page-cta"><div class="container page-cta-inner"><div><p class="eyebrow">For schools and professionals</p><h2>Choosing resources for your setting?</h2><p>Ask about the resources and the use permissions you need.</p></div><a class="button button-primary" href="/contact/#school-enquiries">School enquiries <Icon name="arrow" /></a></div></section>
</BaseLayout>
