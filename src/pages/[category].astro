---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { categories, resources } from '../data/resources';
export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.path.replaceAll('/', '') },
    props: { category },
  }));
}
const { category } = Astro.props;
const categoryResources = resources.filter((resource) => resource.category === category.id);
---
<BaseLayout title={category.title} description={category.description}>
  <a href="/resources/">All resources</a>
  <h1>{category.title}</h1>
  <p>{category.description}</p>
  {category.id === 'emotional-literacy' && <p>The Foundation Series builds shared language and understanding, without telling children how they should think, feel or behave.</p>}
  {category.id === 'worry-anxiety' && <p>Explore worry and anxiety through the Curious Brain Safety Alarm explanation and consider what support might help.</p>}
  {category.id === 'problem-solving' && (
    <>
      <p>These resources support everyday and emotional problem solving.</p>
      <ol>
        <li>What is the problem?</li><li>What could we do?</li>
        <li>What might be good or tricky?</li><li>What shall we try?</li>
      </ol>
      <p>We don’t have to know what to do straight away — we can learn how to work it out.</p>
    </>
  )}
  <section>
    <h2>Explore the resources</h2>
    {categoryResources.map((resource) => <ResourceCard resource={resource} />)}
  </section>
</BaseLayout>
