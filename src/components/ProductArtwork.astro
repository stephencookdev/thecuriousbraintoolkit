---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props { image: string; imageAlt: string; bundle?: boolean; }
const { image, imageAlt, bundle = false } = Astro.props;
---
<div class:list={['product-artwork', { 'product-artwork-bundle': bundle }]}>
  <div class="product-badges"><span class="product-pill product-pill-age">Ages 8–11</span><span class="product-pill product-pill-format"><Icon name="document" /> Printable PDF</span></div>
  <img src={image} alt={imageAlt} width="1000" height="667" loading="lazy" />
  <div class="product-artwork-caption"><span class="product-pill product-pill-contents">{bundle ? '2 connected psychology toolkits' : 'Printable psychology resource'}</span>{bundle && <span class="product-contents">2 learn pages · 6 explore activities · 2 adult guides</span>}<span class="product-evidence">Created by a {site.creator.role}</span></div>
</div>
