---
import Icon from './Icon.astro';
interface Props { id: string; title: string; bundle?: boolean; }
const { id, title, bundle = false } = Astro.props;
---
<div class:list={['product-artwork', { 'product-artwork-bundle': bundle }]}>
  <div class="product-badges"><span class="product-pill product-pill-age">Ages 8–11</span><span class="product-pill product-pill-format"><Icon name="document" /> Printable PDF</span></div>
  <img src={`/images/products/${id}-v2.webp`} alt={`${title}: toolkit covers and sample activity pages`} width="1000" height="667" loading="lazy" />
  <div class="product-artwork-caption"><span class="product-pill product-pill-contents">{bundle ? '2 connected psychology toolkits' : 'Printable psychology toolkit'}</span>{bundle && <span class="product-contents">2 learn pages · 6 explore activities · 2 adult guides</span>}<span class="product-evidence">Created by a Clinical Psychologist</span></div>
</div>
