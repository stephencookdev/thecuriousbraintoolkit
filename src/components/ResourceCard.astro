---
import type { Resource } from '../data/resources';
import Icon from './Icon.astro';
import ProductArtwork from './ProductArtwork.astro';
interface Props { resource: Resource; }
const { resource } = Astro.props;
---
<article class="resource-card">
  {resource.image && <a href={resource.etsyUrl ?? '/resources/'} class="resource-image-link" aria-label={`Explore ${resource.title}`}>{['thoughts-feelings-bundle', 'thoughts', 'feelings', 'safety-alarm'].includes(resource.id) ? <ProductArtwork id={resource.id} title={resource.title} bundle={resource.id === 'thoughts-feelings-bundle'} /> : <img src={resource.image} alt={resource.imageAlt ?? resource.title} width="600" height="600" loading="lazy" />}</a>}
  <div class="resource-card-body">
    <p class="resource-meta">Ages 8–11 <span aria-hidden="true">·</span> Printable PDF</p>
    <h3>{resource.title}</h3><p>{resource.description}</p>
    <div class="resource-actions">
      {resource.etsyUrl && <a class="button button-primary" href={resource.etsyUrl}>Individual use on Etsy <Icon name="external" /></a>}
      {resource.tesUrl ? <a class="text-link" href={resource.tesUrl}>School licence on TES <Icon name="external" /></a> : <a class="text-link school-enquiry" href="/contact/#school-enquiries">School licence enquiries <Icon name="arrow" /></a>}
      {resource.free && resource.downloadUrl && <a class="button button-primary" href={resource.downloadUrl} download>Download {resource.title}</a>}
    </div>
  </div>
</article>
