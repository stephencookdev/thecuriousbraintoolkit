---
import { navigation, policyPages, site } from '../data/site';
---
<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a class="brand-mark" href="/">
        <img src="/images/curious-brain-wordmark.webp" alt={site.name} width="600" height="212" loading="lazy" />
        <sup aria-hidden="true">®</sup>
      </a>
      <p>{site.tagline}</p>
      <p class="small">For children aged 8–11.<br />And the adults alongside them.</p>
    </div>
    <nav aria-label="Footer navigation"><p class="footer-label">Explore</p><ul>{navigation.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}</ul></nav>
    <nav aria-label="Information"><p class="footer-label">Useful information</p><ul><li><a href="/contact/">Contact</a></li>{policyPages.map(({ slug, title }) => <li><a href={`/${slug}/`}>{title}</a></li>)}</ul></nav>
    <div>
      <p class="footer-label">Find the resources</p>
      <p>Printable tools to explore together, at home or in your work.</p>
      {site.etsyUrl && <a class="text-link" href={site.etsyUrl}>Visit the Etsy shop ↗</a>}
      <p class="social-links">
        {site.instagramUrl && <a href={site.instagramUrl}>Instagram ↗</a>}
        <a href={site.tiktokUrl}>TikTok ↗</a>
      </p>
    </div>
  </div>
  <div class="container footer-bottom">
    <div class="footer-legal">
      <p>{site.name} is a registered trade mark of SARAH COOK PSYCHOLOGY LTD.</p>
      <p>This website is operated by SARAH COOK PSYCHOLOGY LTD, company number 14931756. Registered office: 3 Swan Road, Seaton, England, EX12 2US.</p>
    </div>
    <p>© {new Date().getFullYear()} {site.name}<br />Created by {site.creator.name}, {site.creator.role}</p>
  </div>
</footer>
