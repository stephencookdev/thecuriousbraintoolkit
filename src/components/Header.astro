---
import { navigation, site } from '../data/site';
import { categories } from '../data/resources';
import Icon from './Icon.astro';
const currentPath = Astro.url.pathname;
const isCurrentPage = (href: string) => currentPath === href || (
  href === '/resources/' && (currentPath.startsWith('/resources/') || categories.some((category) => category.path === currentPath))
);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand brand-mark" href="/" aria-label={`${site.name} — home`}>
      <img src="/images/curious-brain-wordmark.webp" alt="" width="600" height="212" />
      <sup aria-hidden="true">®</sup>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation"><ul>
      {navigation.map(({ label, href }) => <li><a class="nav-link" href={href} aria-current={isCurrentPage(href) ? 'page' : undefined}><span class="nav-label">{label}</span></a></li>)}
    </ul></nav>
    <details class="mobile-menu">
      <summary aria-label="Open navigation"><Icon name="menu" /><span>Menu</span></summary>
      <nav aria-label="Mobile navigation"><ul>
        {navigation.map(({ label, href }) => <li><a class="nav-link" href={href} aria-current={isCurrentPage(href) ? 'page' : undefined}><span class="nav-label">{label}</span></a></li>)}
      </ul></nav>
    </details>
  </div>
</header>
