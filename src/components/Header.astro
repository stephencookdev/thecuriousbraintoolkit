---
import { navigation, site } from '../data/site';
import { categories } from '../data/resources';
import Icon from './Icon.astro';
const currentPath = Astro.url.pathname;
const isCurrentPage = (href: string) => currentPath === href || (
  href === '/resources/' && (currentPath.startsWith('/resources/') || categories.some((category) => category.path === currentPath))
);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand brand-mark" href="/" aria-label={`${site.name} — home`}>
      <img src="/images/curious-brain-wordmark.webp" alt="" width="600" height="212" />
      <sup aria-hidden="true">®</sup>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation"><ul>
      {navigation.map(({ label, href }) => <li><a class="nav-link" href={href} aria-current={isCurrentPage(href) ? 'page' : undefined}><span class="nav-label">{label}</span></a></li>)}
    </ul></nav>
    <details class="mobile-menu">
      <summary aria-label="Open navigation"><Icon name="menu" /><span>Menu</span></summary>
      <nav aria-label="Mobile navigation"><ul>
        {navigation.map(({ label, href }) => <li><a class="nav-link" href={href} aria-current={isCurrentPage(href) ? 'page' : undefined}><span class="nav-label">{label}</span></a></li>)}
      </ul></nav>
    </details>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('.desktop-nav');
  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('.nav-link')];
    const active = links.find((link) => link.getAttribute('aria-current') === 'page');
    const moveIndicator = (link: HTMLAnchorElement | undefined) => {
      nav.classList.toggle('has-indicator-target', Boolean(link));
      if (link) {
        const offset = link.offsetLeft + link.offsetWidth / 2;
        nav.style.setProperty('--indicator-center', `${offset}px`);
      }
    };
    const restoreIndicator = () => {
      moveIndicator(links.find((link) => link.matches(':focus-visible')) ?? active);
    };

    restoreIndicator();
    nav.classList.add('has-sliding-indicator');

    for (const link of links) {
      link.addEventListener('pointerenter', () => moveIndicator(link));
      link.addEventListener('focus', () => moveIndicator(link));
    }
    nav.addEventListener('pointerleave', restoreIndicator);
    nav.addEventListener('focusout', () => queueMicrotask(() => {
      moveIndicator(links.find((link) => link.matches(':hover, :focus-visible')) ?? active);
    }));
    new ResizeObserver(() => {
      moveIndicator(links.find((link) => link.matches(':hover, :focus-visible')) ?? active);
    }).observe(nav);
  }
</script>
